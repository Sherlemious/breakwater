# ============= DASH SETTINGS =============
FLASK_ENV=development
DASH_DEBUG=True
PORT=8050

# ============= DATA SETTINGS =============
DATA_DIR=data
ANOMALY_THRESHOLD=0.70
REFRESH_INTERVAL_SEC=5

# ============= SERVICE ENDPOINTS =============
MITIGATION_SERVICE_URL=http://localhost:5001
BASELINE_SERVICE_URL=http://localhost:5002
DETECTION_SERVICE_URL=http://localhost:5003

# ============= EMAIL NOTIFICATIONS =============
EMAIL_ENABLED=False
EMAIL_PROVIDER=gmail
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ============= SLACK =============
SLACK_ENABLED=False
SLACK_WEBHOOK_URL=

# ============= WHATSAPP / SMS (TWILIO) =============
WHATSAPP_ENABLED=False
SMS_ENABLED=False

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=
TWILIO_PHONE_TO=

# ============= ALERT SYSTEM =============
ALERT_COOLDOWN_SEC=120
NOTIFICATION_LOG_FILE=data/notification_log.json
LOCAL_NOTIFICATIONS_ENABLED=True

# ============= DASHBOARD BROWSER NOTIFICATIONS =============
# The React dashboard can show in-app/browser alerts without email credentials.
BROWSER_NOTIFICATIONS_ENABLED=True
EMAIL_NOTIFICATIONS_ENABLED=auto
NOTIFICATION_THRESHOLD=0.70
NOTIFICATION_COOLDOWN_SECONDS=1800

# Optional SMTP email for dashboard/backend/app.py. Leave blank to use browser alerts only.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ddos-sentinel@demo.local
ALERT_EMAIL=

# ============= LOGGING =============
LOG_LEVEL=INFO
LOG_FILE=logs/dashboard.log

# ============= SECURITY =============
SECRET_KEY=change-this-in-production

# ============= DOCKER =============
DOCKER_ENV=production
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
